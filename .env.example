# Copy to .env and fill in. Never commit .env. Values here are placeholders.

# --- Server ---
NODE_ENV=development
PORT=8787
# IANA zone used to interpret all-day dates and to render times
APP_TIMEZONE=America/New_York



# SQLite file (relative to apps/server when run via npm scripts)
DATABASE_PATH=./data/planner.db

# --- OAuth token storage ---
# auto = OS keyring (Windows Credential Manager / macOS Keychain) when available, else encrypted file
TOKEN_STORE=auto
TOKEN_FILE_PATH=./data/tokens.enc.json
# Required for the file store (servers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Google (Desktop OAuth client from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated calendar IDs to sync; the first is the default for new events
GOOGLE_CALENDAR_IDS=primary
GOOGLE_SYNC_INTERVAL_MINUTES=10
GOOGLE_SYNC_LOOKBACK_DAYS=30

# --- Canvas LMS (read-only) ---
# Option A (preferred): REST API with a personal access token
#   Canvas → Account → Settings → "+ New Access Token"
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Option B (if your school disables tokens): your calendar feed URL
#   Canvas → Calendar → "Calendar Feed" (bottom right). Treat this URL as a password.
CANVAS_ICS_URL=
CANVAS_SYNC_INTERVAL_MINUTES=30
CANVAS_LOOKBACK_DAYS=30
CANVAS_LOOKAHEAD_DAYS=120
# Store per-course current grade (the UI hides grades unless you turn them on)
CANVAS_SYNC_GRADES=true
