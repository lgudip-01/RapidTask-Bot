# Copy to .env and fill in. Never commit .env. Values here are placeholders.

# --- Server ---
NODE_ENV=development
PORT=8787
# IANA zone used to interpret all-day dates and to render times
APP_TIMEZONE=America/New_York



# SQLite file (relative to apps/server when run via npm scripts)
DATABASE_PATH=./data/planner.db

# --- OAuth token storage ---
# auto = OS keyring (Windows Credential Manager / macOS Keychain) when available, else encrypted file
TOKEN_STORE=auto
TOKEN_FILE_PATH=./data/tokens.enc.json
# Required for the file store (servers). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Google (Desktop OAuth client from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated calendar IDs to sync; the first is the default for new events
GOOGLE_CALENDAR_IDS=primary
GOOGLE_SYNC_INTERVAL_MINUTES=10
GOOGLE_SYNC_LOOKBACK_DAYS=30

# --- Canvas LMS (read-only) ---
# Option A (preferred): REST API with a personal access token
#   Canvas → Account → Settings → "+ New Access Token"
CANVAS_BASE_URL=
CANVAS_TOKEN=
# Option B (if your school disables tokens): your calendar feed URL
#   Canvas → Calendar → "Calendar Feed" (bottom right). Treat this URL as a password.
CANVAS_ICS_URL=
CANVAS_SYNC_INTERVAL_MINUTES=30
CANVAS_LOOKBACK_DAYS=30
CANVAS_LOOKAHEAD_DAYS=120
# Store per-course current grade (the UI hides grades unless you turn them on)
CANVAS_SYNC_GRADES=true

# --- Message parser (Claude API) ---
# Without a key, only the built-in fast path parses messages ("dentist tues 3pm").
ANTHROPIC_API_KEY=
PARSER_LLM_ENABLED=true
PARSER_MODEL=claude-opus-5-5
# low keeps SMS replies fast; raise to medium/high if parses look wrong
PARSER_EFFORT=low
PARSER_TIMEOUT_MS=20000

# --- Inbound capture (text the app) ---
# Public https origin of the deployed server (webhook registration; Twilio signature URL)
PUBLIC_BASE_URL=
INBOUND_RATE_LIMIT_PER_10_MIN=20

# Telegram: create a bot with @BotFather; get your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# polling = local dev (no public URL); webhook = production (npm run telegram -- set-webhook)
TELEGRAM_MODE=polling
# 16-256 chars of A-Z a-z 0-9 _ - ; generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE_E164=
# Only if Twilio calls a URL other than PUBLIC_BASE_URL/webhooks/twilio
TWILIO_WEBHOOK_URL=

# --- Access control (required in production) ---
# none (local dev only) | password (single-user login) | cloudflare (behind Cloudflare Access)
AUTH_MODE=none
# From: npm run hash-password -w @planner/server
AUTH_PASSWORD_HASH=
# >= 32 random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=30
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# true only behind a proxy that sets Fly-Client-IP / X-Forwarded-* (Fly.io)
TRUST_PROXY=false
WEBHOOK_RATE_LIMIT_PER_MIN=60
# Serve the built UI from the server (set in the Docker image)
WEB_DIST_DIR=

# --- Backups (Litestream → S3-compatible storage; AWS_* credentials from `fly storage create`) ---
LITESTREAM_REPLICA_URL=
